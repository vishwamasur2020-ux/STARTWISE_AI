# Application
APP_NAME=STARTWISE_AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database - Neon PostgreSQL
DATABASE_URL=postgresql+asyncpg://username:password@ep-xxx.neon.tech/startwise?sslmode=require
DATABASE_SYNC_URL=postgresql://username:password@ep-xxx.neon.tech/startwise?sslmode=require

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ML Models path
ML_MODELS_PATH=app/ml/models

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
