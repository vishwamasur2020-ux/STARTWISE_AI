# Application
APP_NAME=STARTWISE_AI
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database - Neon PostgreSQL
DATABASE_URL=postgresql+asyncpg://username:password@ep-xxx.neon.tech/startwise?sslmode=require
DATABASE_SYNC_URL=postgresql://username:password@ep-xxx.neon.tech/startwise?sslmode=require

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Host Security
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5173
ALLOWED_HOSTS=your-backend-domain.com,localhost,127.0.0.1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ML Engine & Artifacts
ML_MODELS_PATH=app/ml/models
MODEL_VERSION=1.0.0

# Email Delivery Configuration (Provider Architecture)
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp

# SMTP Provider Settings (Standard Gmail: 587 STARTTLS)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=STARTWISE AI

# Resend API Provider (Optional / Fallback)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=STARTWISE AI <onboarding@resend.dev>
EMAIL_FROM_NAME=STARTWISE AI

# External Provider / OAuth Credentials (Backend Only)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# OTP & Email Verification Security
OTP_SECRET=your-secure-otp-secret-key-min-32-chars
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=3
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# Report Generation & Storage
REPORT_STORAGE_DIR=reports

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
