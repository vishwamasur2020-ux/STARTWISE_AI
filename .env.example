# =============================================================================
# STARTWISE AI — Production Environment Configuration (.env.example)
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. BACKEND SERVICE (FastAPI)
# ─────────────────────────────────────────────────────────────────────────────

# Application Info
APP_NAME=STARTWISE_AI
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Server Network
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database — Neon PostgreSQL (Serverless Async + Sync URLs)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-host>.neon.tech/<dbname>?sslmode=require
DATABASE_SYNC_URL=postgresql://<username>:<password>@<neon-host>.neon.tech/<dbname>?sslmode=require

# JWT Authentication & Cryptography
JWT_SECRET_KEY=generate-a-cryptographically-secure-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Host Whitelisting (comma-separated or JSON array)
ALLOWED_ORIGINS=https://startwise-ai.vercel.app,http://localhost:5173
ALLOWED_HOSTS=startwise-api.onrender.com,localhost,127.0.0.1

# Rate Limiting (Requests per IP within period)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ML Engine & Trained Artifacts
ML_MODELS_PATH=app/ml/models
MODEL_VERSION=1.0.0

# Email Delivery Configuration (Provider Architecture)
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp

# SMTP Provider Settings (Standard Gmail: 587 STARTTLS)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=STARTWISE AI

# Resend API Provider (Optional / Fallback)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=STARTWISE AI <onboarding@resend.dev>
EMAIL_FROM_NAME=STARTWISE AI

# External Provider / OAuth Credentials (Backend Only)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# OTP & Email Verification Security
OTP_SECRET=your-secure-otp-secret-key-min-32-chars
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=3
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# PDF Report Storage
REPORT_STORAGE_DIR=reports

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log


# ─────────────────────────────────────────────────────────────────────────────
# 2. FRONTEND SERVICE (React + Vite + TailwindCSS)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for Backend API
VITE_API_URL=http://localhost:8000/api/v1
# In Production: VITE_API_URL=https://startwise-api.onrender.com/api/v1
